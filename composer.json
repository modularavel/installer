{
    "name": "modularavel/installer",
    "description": "Start a new project in Laravel quickly, objectively, and simply without having to wait step by step to confirm or deny questions during the installation! Here you can define everything and leave it installing; when you get back from having a coffee, the project will already be running :)",
    "keywords": [
        "laravel",
        "modularavel",
        "starterkit",
        "laravel modules",
        "modular",
        "modularity"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Casimiro Rocha",
            "email": "contato@crsistemas.dev.br"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/filesystem": "^10.20|^11.0|^12.0",
        "illuminate/support": "^10.20|^11.0|^12.0",
        "laravel/prompts": "^0.1.18|^0.2.0|^0.3.0",
        "symfony/console": "^6.2|^7.0",
        "symfony/process": "^6.2|^7.0",
        "symfony/polyfill-mbstring": "^1.31"
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.4"
    },
    "bin": [
        "bin/modularavel"
    ],
    "autoload": {
        "psr-4": {
            "Modularavel\\Installer\\Console\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Modularavel\\Installer\\Console\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
